# Actual intermediate filenames the scripts write (2026-08 audit: the
# patterns above did not match these — a regeneration followed by a
# careless `git add -A` would have committed ~100+ MB of binaries)
# WS1 tweet embeddings: scripts/01_embed_corpus.py
analyses/ws1-sentence-transformers/intermediate/emb_tier*.npz
# WS2 token/TF-IDF intermediates: scripts/01_prepare_tokens.py
analyses/ws2-topic-bakeoff/intermediate/tokens.pkl
analyses/ws2-topic-bakeoff/intermediate/tfidf.npz
analyses/ws2-topic-bakeoff/intermediate/vocab.json
analyses/ws2-topic-bakeoff/intermediate/eval_idx.npy
# WS4 tokenization + GloVe intermediates: scripts/01_prepare.py, 02_embed.py
analyses/ws4-preanalysis/outputs/tokenized_corpus.jsonl.gz
analyses/ws4-preanalysis/outputs/corpus_glove.txt
analyses/ws4-preanalysis/outputs/glove_*
# Corpus generator: uncompressed intermediate (also deleted by the script)
data/synthetic-candidate-tweets/synthetic_candidate_tweets_2022.csv
# Pilot (00-embeddings-pca) regenerable binaries + its honor-system truth
# file, so a pilot rerun can't stage them via `git add -A`. NOTE: a rerun
# also rewrites the pilot's TRACKED outputs (validation_results.csv — the
# frozen 07-20 reference — candidate_metadata.csv, pair CSVs, figures);
# those can't be gitignored, but they surface as modifications in git diff.
# The pilot's w2v is nondeterministic (workers=4), so do not commit rerun
# outputs over the frozen originals.
analyses/00-embeddings-pca/outputs/ground_truth_SEALED.csv
analyses/00-embeddings-pca/outputs/tokenized_corpus.jsonl.gz
analyses/00-embeddings-pca/outputs/candidate_vectors.npz
analyses/00-embeddings-pca/outputs/pca_scores.npz
analyses/00-embeddings-pca/outputs/distance_matrix_*.npy

# WS4 supervised: tweet-level caches + doc2vec model + fitted models (~310 MB),
# rebuilt by analyses/ws4-supervised/scripts/01_features.py and 02_probes.py
analyses/ws4-supervised/intermediate/
# WS4 DEV-only label release (derived from sealed truth; rebuilt by ws0-harness/06_label_release.py)
ws0-harness/ws4_dev_labels.parquet
